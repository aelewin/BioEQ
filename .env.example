# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application host — use 127.0.0.1 for local use.
# Set to 0.0.0.0 ONLY when behind an authenticated reverse proxy.
BIOEQ_HOST=127.0.0.1

# Application port
BIOEQ_PORT=4000

# Maximum upload size in MB
BIOEQ_MAX_UPLOAD_MB=50
